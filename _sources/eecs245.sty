% Solution environment (conditionally displayed based on flag)
\newenvironment{solution}{
  \ifshowsolutions
    \begin{tcolorbox}[
      colback=lightgray, 
      colframe=black, 
      boxrule=0.6pt, 
      arc=0pt, 
      left=10pt, 
      right=10pt, 
      top=8pt, 
      bottom=8pt,
      breakable,
      enhanced,
      break at=\textheight,
      pad at break*=0pt,
      lefttitle=0pt,
      righttitle=0pt,
      toptitle=0pt,
      bottomtitle=0pt
    ]
    \textbf{Solution: }
  \else
    \setbox0=\vbox\bgroup
  \fi
}{
  \ifshowsolutions
    \end{tcolorbox}
  \else
    \egroup
  \fi
}

% Empty box command for creating outlined boxes
\NewDocumentCommand{\emptybox}{O{\linewidth} m}{%
  % #1 width (optional, defaults to \linewidth to match solution boxes), #2 height (required)
  \ifshowsolutions
    % If solutions are shown, don't render empty boxes, but absorb trailing \\ and whitespace
    \ignorespaces
  \else
    \fbox{%
      \begin{minipage}[c][#2][c]{#1}%
        \phantom{.}%
      \end{minipage}%
    }%
  \fi
}

% Bubble commands for multiple choice problems
% Improved bubble commands for better alignment, larger bubbles, and more whitespace after text

% Bubble with argument for text, better vertical alignment, larger size, and more trailing space
\newcommand{\bubble}[1]{%
  \raisebox{-0.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt] (0,0) circle (0.55em);}%
  \hspace{0.5em}#1\hspace{1.2em}%
}

\newcommand{\squarebubble}[1]{%
  \raisebox{-1.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt] (0,0) rectangle (1.1em,1.1em);}%
  \hspace{0.5em}#1\hspace{1.2em}%
}

\newcommand{\correctbubble}[1]{%
  \ifshowsolutions
    \raisebox{-0.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt,fill=black] (0,0) circle (0.55em);}%
    \hspace{0.5em}#1\hspace{1.2em}%
  \else
    \raisebox{-0.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt] (0,0) circle (0.55em);}%
    \hspace{0.5em}#1\hspace{1.2em}%
  \fi
}

\newcommand{\correctsquarebubble}[1]{%
  \ifshowsolutions
    \raisebox{-1.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt,fill=black] (0,0) rectangle (1.1em,1.1em);}%
    \hspace{0.5em}#1\hspace{1.2em}%
  \else
    \raisebox{-1.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt] (0,0) rectangle (1.1em,1.1em);}%
    \hspace{0.5em}#1\hspace{1.2em}%
  \fi
}

% Filled bubble command - always shows filled bubble regardless of solutions visibility
\newcommand{\filledbubble}[1]{%
  \raisebox{-0.2ex}{\tikz[baseline={(0,-0.7ex)}]\draw[line width=1pt,fill=black] (0,0) circle (0.55em);}%
  \hspace{0.5em}#1\hspace{1.2em}%
}

% Minibox command for exam blanks with conditional answers and optional height
\NewDocumentCommand{\minibox}{m m O{4em}}{%
  % #1 = width, #2 = correct answer, #3 = height (optional, defaults to 4em)
  \ifshowsolutions
    \fbox{%
      \begin{minipage}[c][#3][c]{#1}%
        \centering\textbf{#2}%
      \end{minipage}%
    }%
  \else
    \fbox{%
      \begin{minipage}[c][#3][c]{#1}%
        \phantom{.}%
      \end{minipage}%
    }%
  \fi
}

% Large answer area with a bottom-right "<label> = minibox"
\NewDocumentCommand{\labeledanswerbox}{m m O{2.2cm} O{3cm} O{4em}}{%
  % #1 = label before "=" (e.g., k), #2 = correct answer,
  % #3 = large box height, #4 = minibox width, #5 = minibox height
  \noindent
  % baseline=(ansbox.south): default TikZ baseline is y=0 (top of box here), which can
  % confuse TeX's vertical list and leave spurious glue below the picture.
  \begin{tikzpicture}[baseline=(ansbox.south)]
    \node[draw, inner sep=0pt, minimum width=\dimexpr\linewidth-0.8pt\relax, minimum height=#3, anchor=north west] (ansbox) at (0,0) {};
    \node[anchor=south east, xshift=-6pt, yshift=6pt] at (ansbox.south east) {$#1 = \minibox{#4}{#2}[#5]$};
  \end{tikzpicture}%
}

% Backwards-compatible wrapper for legacy usage
\NewDocumentCommand{\kanswerbox}{m O{2.2cm} O{3cm} O{4em}}{%
  \labeledanswerbox{k}{#1}[#2][#3][#4]
}

% Title block convenience
\newcommand{\makemytitle}[6]{%
  % #1 course, #2 term, #3 assignment, #4 due, #5 submission instructions, #6 room options (for exam mode)
  \eecsSubmissionHeader{#1}{#2}{#3}{#4}{#5}{#6}
}

