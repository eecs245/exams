% SOLUTION DISPLAY FLAG - Set to true to show solutions, false to hide them
\newif\ifshowsolutions
\showsolutionsfalse % Default: hide solutions

% Command to enable solution display (call this in your document preamble)
\newcommand{\enablesolutions}{\showsolutionstrue}

% STUDENT INFO SECTION FLAG - Set to true to include name/uniqname section, false to hide it
\newif\ifshowstudentinfo
\showstudentinfofalse % Default: hide student info section

% Command to enable student info section (call this in your document preamble)
\newcommand{\enablestudentinfo}{\showstudentinfotrue}

% EXAM FLAG - Set to true to include UMID and room options in student info section
\newif\ifisexam
\isexamfalse % Default: not an exam

% Command to enable exam mode (call this in your document preamble)
