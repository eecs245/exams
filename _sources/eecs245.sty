% Exam mode: Add uniqname box to top-right corner of odd pages starting from page 3
% Define a command that checks page number (evaluated at typeset time)
\newcommand{\examuniqnameheader}{%
  \ifnum\c@page>2\relax
    \ifodd\c@page%
      \begin{flushright}
        \hspace{20em} \textbf{uniqname:} \hrulefill
      \end{flushright}
    \fi
  \fi
}

% Use AtBeginDocument to ensure this runs after \enableexam is called
\AtBeginDocument{%
  \ifisexam
    \fancyhead[RO]{\examuniqnameheader}
    \fancyhead[RE]{} % Clear even page headers
    \fancyhead[LO]{} % Clear left odd page headers
    \fancyhead[LE]{} % Clear left even page headers
  \fi
}

% Problem and activity environments
\theoremstyle{definition}
\newtheorem{problem}{Problem}
\newtheorem{activitythm}{Activity}

% Subproblem counter (resets with each problem)
\newcounter{subproblem}[problem]
\renewcommand{\thesubproblem}{\alph{subproblem}}

% Subactivity counter (resets with each activity)
\newcounter{subactivity}[activitythm]
\renewcommand{\thesubactivity}{\alph{subactivity}}

% Helper: format Problem/Lab header. Exam headers never use a colon after
% the problem number; non-exam titles keep the old named-title colon behavior.
\ExplSyntaxOn
\tl_new:N \l__eecs_probheader_title_tl
\cs_new:Npn \__eecs_probheader_label:
  {
    \ifislab
      Lab~\theproblem
    \else
      Problem~\theproblem
    \fi
  }
\cs_new_protected:Npn \eecs_probheader:n #1
  {
    \tl_if_eq:nnTF {#1} {\@empty}
      { \__eecs_probheader_label: }
      {
        \ifisexam
          \__eecs_probheader_label: \ #1
        \else
          \tl_set:Nx \l__eecs_probheader_title_tl { \tl_to_str:n {#1} }
          \regex_match:nVTF { \A \( .* \s+ pts? \) \Z } \l__eecs_probheader_title_tl
            { \__eecs_probheader_label: \ #1 }
            { \__eecs_probheader_label: :\ #1 }
        \fi
      }
  }
\cs_new_protected:Npn \eecsprobheader #1 { \eecs_probheader:n {#1} }
\ExplSyntaxOff
\newcommand{\@probheader}[1]{\eecsprobheader{#1}}

% User-facing shorthands
\newenvironment{prob}[1][\@empty]{% optional title
  \refstepcounter{problem}%
  {\noindent\large\textbf{\@probheader{#1}}}\\[0.4em]%
}{\vspace{1.5em}} % Slightly increase spacing after each problem

\newenvironment{activity}[1][\@empty]{% optional title
  \refstepcounter{activitythm}{\noindent\large\textbf{Activity~\theactivitythm\ifx#1\@empty\else:\ #1\fi}}\\[0.4em]
}{\vspace{1.5em}} % Slightly increase spacing after each activity

\newenvironment{subprob}{%
  \refstepcounter{subproblem}%
  \begin{list}{}{\leftmargin=1.5em\rightmargin=0pt\parsep=0pt\itemsep=0pt\topsep=0pt}%
  \item[\textbf{\thesubproblem)}]%
}{\end{list}\vspace{0.2em}}

\newenvironment{subactivity}{%
  \refstepcounter{subactivity}%
  \begin{list}{}{\leftmargin=1.5em\rightmargin=0pt\parsep=0pt\itemsep=0pt\topsep=0pt}%
  \item[\textbf{\thesubactivity)}]%
}{\end{list}}

% Boxed submission header macro
\newtcolorbox{eecsheaderbox}{colback=white, colframe=black, boxrule=0.6pt, arc=0pt, left=10pt, right=10pt, top=8pt, bottom=8pt}

\newcommand{\eecsSubmissionHeader}[6]{%
  % #1 course, #2 term, #3 assignment, #4 due, #5 submission instructions (can be multiline), #6 room options (for exam mode)
  {\Large\bfseries #3\ifshowsolutions\ \textcolor{red}{Solutions}\fi}\\[0.4em]
  \IfStrEq{#2}{}{%
    {\large #1}\\[0.4em]
  }{%
    {\large #1, #2}\\[0.4em]
  }%
  \ifx\relax#4\relax
  \else
    {\textbf{due} #4}\\
  \fi
  % \noindent\rule{\linewidth}{0.4pt}
  \ifshowstudentinfo
    \begin{tcolorbox}[colback=white, colframe=black, boxrule=0.6pt, arc=0pt, left=10pt, right=10pt, top=8pt, bottom=8pt]
      \vspace{1em}
      \textbf{Name:} \hrulefill \\ \\ \\
      \textbf{uniqname:} \hrulefill \\
      \ifisexam
        \\ \\
        \textbf{UMID:} \hrulefill \\ \\
        \textbf{Room:} #6 \\
      \fi
    \end{tcolorbox}
  \fi
  \begin{tcolorbox}[colback=lightgray, colframe=black, boxrule=0.6pt, arc=0pt]
    #5
  \end{tcolorbox}
}

